# r15-r18-migrate runner 環境設定範本
#
# 用法：複製成 env 檔（預設位置 $HOME/.claude/r15-r18-migrate.env）後填值，並 chmod 600。
#   cp r15-r18-migrate.env.example "$HOME/.claude/r15-r18-migrate.env"
#   chmod 600 "$HOME/.claude/r15-r18-migrate.env"
#   bash helpers/run-migration.sh
#
# 檔內含長效憑證，禁止進版控、禁止貼進任何對話或報告。
# 標示「必填」的 5 個變數沒填，runner 會在 pre-flight 就停下。
#
# 注意：R15_R18_MIGRATE_ENV 不是本檔內的變數，不要寫在這裡。
# 它是 run-migration.sh 用來「找這份 env 檔本身放在哪」的 bootstrap 變數
# （由 launchd.plist.template 的 EnvironmentVariables 區塊設定），
# 優先序是「第一個參數 > R15_R18_MIGRATE_ENV > 家目錄下的預設位置」（見 run-migration.sh 開頭註解）。
# 本檔內的變數都是給 runner.py／notify.sh 在執行期讀的設定，跟這個 bootstrap 變數是兩回事。

# ---------------------------------------------------------------- repo 與分支

# 必填：目標 repo 的工作目錄路徑
REPO_DIR=

# 整合分支名稱；所有頁面分支從它的 HEAD 切出，完成後 fast-forward 併回
INTEGRATION_BRANCH=feat/r18-migration

# 基準分支名稱；每個模組開工前會與它同步，斷點 PR 預設開回這裡
BASE_BRANCH=master

# 必填：頁面分支名稱第三段的使用者代號
# 分支樣板為 <JIRA-KEY>/refactor/<BRANCH_USER>/<entry-id>，由 import-inventory 產生
BRANCH_USER=

# 狀態目錄；留空時預設為 $HOME/r18-migration-state/<repo 目錄名>
# 若指到 repo 內，啟動時必須先被 git 忽略，否則 pre-flight 失敗
MIGRATION_STATE_DIR=

# ---------------------------------------------------------------- CLI 與憑證

# CLI 執行檔名稱或完整路徑
CLAUDE_BIN=claude

# 呼叫遷移 skill 時指定的模型
CLAUDE_MODEL=sonnet

# 隔離用的設定目錄；留空表示用 CLI 預設值
# 建議指到一個只放 settings.json 與本 skill 的最小目錄，避免載入日常 hooks/plugins
CLAUDE_CONFIG_DIR=

# 必填：長效 OAuth 憑證（由 `claude setup-token` 產生）
# 只寫在本檔，不要放進版控或任何設定檔
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub CLI 執行檔名稱或完整路徑（用來開 PR）
GH_BIN=gh

# ---------------------------------------------------------------- 單模組上限

# 單一模組單次呼叫的預算上限（美元）
MODULE_BUDGET_USD=15

# 單一模組呼叫的 wall-clock 逾時（分鐘）；逾時先送 TERM，30 秒後 KILL
MODULE_TIMEOUT_MIN=150

# 單一 entry 允許的最大檔案數；超過在 import-inventory 就標成 blocked(too_large)
ENTRY_MAX_FILES=12

# 單一 entry 允許的最大總行數
ENTRY_MAX_LINES=4000

# ---------------------------------------------------------------- 額度與等待

# 取件前的五小時額度門檻（百分比）；超過就先等到重置時間
QUOTA_PREFLIGHT_FIVE_HOUR=80

# 取件前的七日額度門檻（百分比）
QUOTA_PREFLIGHT_SEVEN_DAY=95

# 等待額度或等待人工放行的總時長上限（小時）
MAX_WAIT_HOURS=168

# ---------------------------------------------------------------- 斷點與熔斷

# 累積多少個模組沒進斷點就自動開一個 soft 斷點
CHECKPOINT_MAX_MODULES=8

# 累積多少行改動沒進斷點就自動開一個 soft 斷點
CHECKPOINT_MAX_LINES=3000

# 連續多少個模組失敗就整體暫停（熔斷）
CIRCUIT_BREAKER_N=3

# ---------------------------------------------------------------- 主機環境

# 磁碟可用空間下限（GB），低於此值 pre-flight 直接失敗
DISK_MIN_GB=20

# sessions/ 原始輸出保留天數
SESSIONS_RETENTION_DAYS=14

# 啟動腳本要切換到的 Node 版本（前端建置用）
NODE_VERSION=20

# ---------------------------------------------------------------- 通知

# 通知管道：line = LINE 推播；其他值（例如 osascript）= 只用本機通知
NOTIFY_CHANNEL=line

# 必填（NOTIFY_CHANNEL=line 時）：LINE Messaging API 的 channel token
LINE_CHANNEL_ACCESS_TOKEN=

# 必填（NOTIFY_CHANNEL=line 時）：推播對象 id
LINE_NOTIFY_TARGET_ID=

# 每月推播則數上限；超過後 INFO 類事件只進摘要佇列不推播
LINE_MONTHLY_CAP=180

# 模組完成是否即時推播（0 = 只進每日摘要）
NOTIFY_ON_DONE=0

# 額度等待是否即時推播（0 = 只留紀錄）
NOTIFY_ON_QUOTA_WAIT=0

# 暫停等待人工處理時，每隔幾小時重複提醒一次
NOTIFY_PAUSE_REMIND_HOURS=24

# 每日摘要的發送時間（24 小時制 HH:MM）
NOTIFY_DAILY_DIGEST=09:00

# ---------------------------------------------------------------- 僅測試用旗標
#
# 下面兩個**只在用假 CLI 做流程測試時**才設定，正式執行一定要保持註解狀態。
# 它們會跳過 L1 的建置與啟動 smoke 驗證，等於關掉「白屏不會被擋下」的防線。

# 僅測試：跳過 L1 的前端建置步驟
# RUNNER_SKIP_BUILD=1

# 僅測試：跳過 L1 的建置產物啟動 smoke
# RUNNER_SKIP_SMOKE=1
